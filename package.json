{
  "name": "calendar",
  "version": "1.5.10",
  "description": "Calendar view of your daily notes",
  "author": "liamcain",
  "main": "main.js",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "lint": "svelte-check && tsc --noEmit && eslint .",
    "build": "pnpm run lint && rollup -c",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "obsidian": "1.13.1",
    "obsidian-calendar-ui": "0.3.12",
    "obsidian-daily-notes-interface": "0.9.5",
    "svelte": "4.2.20",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "moment": "2.31.0",
    "rollup": "4.63.3",
    "rollup-plugin-svelte": "7.2.3",
    "svelte-check": "4.7.6",
    "svelte-preprocess": "6.0.5",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "verbatimModuleSyntax": false
          }
        }
      ]
    },
    "moduleFileExtensions": [
      "js",
      "ts"
    ]
  }
}
